{
	"name": "watcher",
	"version": "1.0.0",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsc -b",
		"start": "node dist/index.js",
		"dev": "node --loader ts-node/esm src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"nodemonConfig": {
		"watch": [
			"src",
			"../../packages/common/src",
			"../../packages/domain/src",
			"../../packages/infrastructure/src",
			"../../packages/application/src"
		],
		"ext": "ts,json",
		"exec": "node --enable-source-maps --loader ts-node/esm src/index.ts"
	},
	"dependencies": {
		"@sentinel/application": "workspace:*",
		"@sentinel/common": "workspace:*",
		"@sentinel/domain": "workspace:*",
		"@sentinel/infrastructure": "workspace:*",
		"dotenv": "^16.4.7",
		"grammy": "^1.32.0",
		"reflect-metadata": "^0.2.2",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"ts-node": "^10.9.2"
	}
}
