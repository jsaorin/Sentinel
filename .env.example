NODE_ENV=local
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
API_PORT=3000
API_VERSION=v1
BASE_PATH=api
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DRY_RUN=false
WEBHOOKS_PORT=3001
HELIUS_WEBHOOK_AUTH_TOKEN=

# Watcher (Telegram threat-signal ingestion)
TELEGRAM_BOT_TOKEN=
# JSON array of channel configs. Example: [{"id":"-1001234567890","label":"Solana Security Alerts"}]
TELEGRAM_CHANNELS=[]

# Realtime sync e2e test (packages/infrastructure/scripts/test-multisig-flow.ts)
TEST_SIGNER_PRIVATE_KEY=
TEST_MULTISIG_ADDRESS=
TEST_API_BASE_URL=https://98-94-161-141.nip.io/api/v1
