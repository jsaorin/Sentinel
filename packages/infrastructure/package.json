{
	"name": "@sentinel/infrastructure",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./prisma": "./generated/client/index.js",
		"./mappers": {
			"import": "./dist/mappers/index.js",
			"types": "./dist/mappers/index.d.ts"
		}
	},
	"scripts": {
		"prisma:generate": "npx prisma generate --schema=./src/prisma/schema",
		"db:migrate": "npx prisma migrate dev --schema=./src/prisma/schema",
		"db:deploy": "npx prisma migrate deploy --schema=./src/prisma/schema",
		"db:reset": "npx prisma db push --force-reset --schema=./src/prisma/schema && pnpm prisma:generate && tsx src/prisma/seed/index.ts",
		"db:seed": "tsx src/prisma/seed/index.ts",
		"prebuild": "pnpm run prisma:generate",
		"build": "tsc -b"
	},
	"prisma": {
		"seed": "tsx src/prisma/seed/index.ts"
	},
	"dependencies": {
		"@coral-xyz/anchor": "0.29.0",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.4.2",
		"@sentinel/application": "workspace:*",
		"@sentinel/common": "workspace:*",
		"@sentinel/domain": "workspace:*",
		"@solana/web3.js": "^1.98.4",
		"@sqds/multisig": "^2.1.4",
		"amqplib": "^0.10.3",
		"dotenv": "^16.4.7",
		"grammy": "^1.32.0",
		"ioredis": "^5.10.1",
		"prisma": "^7.4.2"
	},
	"devDependencies": {
		"@types/amqplib": "^0.10.4",
		"@types/ioredis": "^5.0.0"
	}
}
