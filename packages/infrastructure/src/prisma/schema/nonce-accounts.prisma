model NonceAccount {
  id               String   @id @default(uuid())
  address          String   @unique
  authority        String
  fundedBy         String?  @map("funded_by")
  multisigId       String   @map("multisig_id")
  signerId         String   @map("signer_id")
  externallyFunded Boolean  @map("externally_funded")
  detectedAt       DateTime @default(now()) @map("detected_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  multisig Multisig @relation(fields: [multisigId], references: [id], onDelete: Cascade)
  signer   Signer   @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([authority])
  @@index([multisigId])
  @@index([signerId])
  @@map("nonce_account")
}
