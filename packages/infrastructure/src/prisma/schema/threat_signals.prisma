model ThreatSignal {
  id               String           @id @default(uuid())
  sourceKind       ThreatSourceKind @map("source_kind")
  sourceIdentifier String           @map("source_identifier")
  externalId       String           @map("external_id")
  sourceLabel      String?          @map("source_label")
  content          String
  capturedAt       DateTime         @map("captured_at")
  isThreat         Boolean?         @map("is_threat")
  severity         ThreatSeverity?
  category         ThreatCategory?
  summary          String?
  rawAnalysisJson  Json?            @map("raw_analysis_json")
  analyzedAt       DateTime?        @map("analyzed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  entities ThreatSignalEntity[]

  @@unique([sourceKind, sourceIdentifier, externalId])
  @@index([isThreat])
  @@map("threat_signals")
}

model ThreatSignalEntity {
  id             String              @id @default(uuid())
  threatSignalId String              @map("threat_signal_id")
  kind           AffectedEntityKind
  role           AffectedEntityRole?
  address        String
  contextSnippet String?             @map("context_snippet")
  createdAt      DateTime            @default(now()) @map("created_at")

  threatSignal ThreatSignal @relation(fields: [threatSignalId], references: [id], onDelete: Cascade)

  @@unique([threatSignalId, kind, address])
  @@index([address])
  @@index([kind, address])
  @@map("threat_signal_entities")
}
