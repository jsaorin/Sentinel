{
	"name": "sentinel",
	"version": "0.1.0",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"dev": "bash scripts/dev.sh",
		"dev:stop": "pkill -9 -f 'node.*Sentinel' 2>/dev/null; echo 'All Sentinel processes stopped'",
		"build": "turbo run build",
		"start:api": "pnpm --dir apps/api start",
		"dev:api": "pnpm --dir apps/api dev",
		"start:webhooks": "pnpm --dir apps/webhooks start",
		"dev:webhooks": "pnpm --dir apps/webhooks dev",
		"start:reactor": "pnpm --dir apps/reactor start",
		"dev:reactor": "pnpm --dir apps/reactor dev",
		"start:watcher": "pnpm --dir apps/watcher start",
		"dev:watcher": "pnpm --dir apps/watcher dev",
		"dev:web": "pnpm --dir apps/web dev",
		"build:web": "pnpm --dir apps/web build",
		"start:web": "pnpm --dir apps/web start",
		"test:web": "pnpm --dir apps/web test",
		"prisma:generate": "turbo run prisma:generate",
		"db:migrate": "turbo run db:migrate",
		"db:deploy": "turbo run db:deploy",
		"db:seed": "turbo run db:seed",
		"db:reset": "turbo run db:reset",
		"clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' -exec rm -rf {} + && find . -name '.turbo' -type d -exec rm -rf {} + && find . -name 'tsconfig.tsbuildinfo' -type f -exec rm -f {} +",
		"prepare": "husky || true"
	},
	"packageManager": "pnpm@10.33.0",
	"workspaces": ["packages/*", "apps/*"],
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.13.5",
		"concurrently": "^9.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"nodemon": "^3.1.14",
		"pino-pretty": "^13.0.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@solana/spl-token": "^0.4.14",
		"@solana/web3.js": "^1.98.4",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"envalid": "^8.0.0",
		"express": "^4.21.2",
		"inversify": "^7.1.0",
		"pino-http": "^10.3.0",
		"reflect-metadata": "^0.2.2",
		"turbo": "^2.4.4",
		"zod": "^4.1.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@prisma/engines",
			"esbuild",
			"prisma"
		],
		"overrides": {
			"esbuild": "0.27.2"
		}
	}
}
